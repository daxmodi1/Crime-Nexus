# Copy to .env and fill in. Never commit .env.

# Required. Chat, entity extraction, timeline and anomaly detection all use Groq.
# Get one at https://console.groq.com/keys
GROQ_API_KEY=

# Optional. Enables the "deep research" toggle in chat (web search via Tavily).
# Leave blank to disable. Get one at https://app.tavily.com
TAVILY_API_KEY=

# Optional. Only needed if you switch the pipeline to Google embeddings.
GOOGLE_API_KEY=

# Ollama endpoint used for the nomic-embed-text embedding model.
OLLAMA_BASE_URL=http://localhost:11434

# Where the Chroma vector store lives, relative to the backend directory.
CHROMA_DB_PATH=./chroma_db

# Retrieval tuning.
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K_RETRIEVAL=7
