VITE_API_URL=http://localhost:8000

# Supabase project credentials, used for authentication.
# Project Settings > API in the Supabase dashboard.
# Both must be NON-EMPTY. createClient() throws "supabaseUrl is required." on an
# empty string, which kills the app before React mounts (blank page, no console error).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Local development only. Set to true to skip the Supabase login gate. When enabled,
# the two values above can be any non-empty placeholder. Defaults to false.
VITE_DEV_BYPASS_AUTH=false
